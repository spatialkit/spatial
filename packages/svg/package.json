{
  "name": "@spatialkit/svg",
  "version": "0.1.0",
  "description": "SVG renderer and pointer handlers for @spatialkit/core: pan, zoom, pinch, selection, drag, resize and grid.",
  "keywords": [
    "2d",
    "editor",
    "floor-plan",
    "svg",
    "renderer",
    "pan-zoom",
    "pinch-zoom",
    "typescript"
  ],
  "license": "MIT",
  "author": "Lucas Felix",
  "homepage": "https://github.com/spatialkit/spatial/tree/main/packages/svg#readme",
  "bugs": "https://github.com/spatialkit/spatial/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spatialkit/spatial.git",
    "directory": "packages/svg"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@spatialkit/core": "workspace:*",
    "jsdom": "^27.2.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@spatialkit/core": "0.x"
  },
  "publishConfig": {
    "access": "public"
  }
}
