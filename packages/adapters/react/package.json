{
  "name": "@spatialkit/react",
  "version": "0.1.0",
  "description": "React adapter for @spatialkit/core: SpatialCanvas component and hooks for interactive 2D editors.",
  "keywords": [
    "2d",
    "editor",
    "floor-plan",
    "react",
    "react-hooks",
    "svg",
    "pan-zoom",
    "typescript"
  ],
  "license": "MIT",
  "author": "Lucas Felix",
  "homepage": "https://github.com/spatialkit/spatial/tree/main/packages/adapters/react#readme",
  "bugs": "https://github.com/spatialkit/spatial/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spatialkit/spatial.git",
    "directory": "packages/adapters/react"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@spatialkit/core": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@spatialkit/core": "0.x",
    "react": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
