{
  "name": "spatial",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/core\" --filter \"./packages/svg\" --filter \"./packages/adapters/*\" run build",
    "dev": "pnpm -C packages/examples/js-vanilla dev",
    "dev:react": "pnpm -C packages/examples/react dev",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest --w",
    "typecheck": "tsc --noEmit",
    "release": "changeset version && pnpm install --no-frozen-lockfile && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.19.20",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}