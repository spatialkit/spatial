{
  "name": "floormap",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm -C packages/examples dev",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --verbose",
    "release": "changeset version && pnpm install --no-frozen-lockfile && changeset publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "changesets": "^2.27.7"
  }
}